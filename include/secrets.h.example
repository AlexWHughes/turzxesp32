#pragma once

// Copy this file to secrets.h and fill in your values, then rebuild + flash:
//   cp include/secrets.h.example include/secrets.h
//
// secrets.h is gitignored. Values are used as first-boot defaults when NVS
// has no saved WiFi SSID yet. Saving from the WebUI still overrides them.

#define WIFI_SSID     "YourNetworkName"
#define WIFI_PASSWORD "YourWifiPassword"

// Optional MQTT (leave empty strings if unused)
#define MQTT_HOST     "homeassistant.local"
#define MQTT_PORT     1883
#define MQTT_USER     ""
#define MQTT_PASSWORD ""

// Optional Spotify Now Playing widget (Web API refresh-token flow).
// Create an app at https://developer.spotify.com/dashboard — use the
// Authorization Code flow once on a computer to obtain a refresh token
// with scope user-read-currently-playing (and/or user-read-playback-state).
#define SPOTIFY_CLIENT_ID     "your_client_id"
#define SPOTIFY_CLIENT_SECRET "your_client_secret"
#define SPOTIFY_REFRESH_TOKEN "your_refresh_token"
