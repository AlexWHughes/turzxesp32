#pragma once

// Copy this file to secrets.h and fill in your values, then rebuild + flash:
//   cp include/secrets.h.example include/secrets.h
//
// secrets.h is gitignored. Values are used as first-boot defaults when NVS
// has no saved WiFi SSID yet. Saving from the WebUI still overrides them.

#define WIFI_SSID     "YourNetworkName"
#define WIFI_PASSWORD "YourWifiPassword"

// Optional MQTT (leave empty strings if unused)
#define MQTT_HOST     "homeassistant.local"
#define MQTT_PORT     1883
#define MQTT_USER     ""
#define MQTT_PASSWORD ""
